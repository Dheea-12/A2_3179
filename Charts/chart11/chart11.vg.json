{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 760,
  "height": 900,
  "padding": 10,
  "title": {
    "text": "Beyond Infection: The Health and Economic Burden of Vaccine-Preventable Diseases",
    "subtitle": "Each disease branches into cases, hospital stays and health spending. Bigger circle = bigger number.",
    "anchor": "start",
    "subtitleColor": "#555555"
  },
  "data": [
    {
      "name": "tree",
      "url": "../../data/burden_tree.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [
            {
              "signal": "height"
            },
            {
              "signal": "width - 260"
            }
          ],
          "as": [
            "y",
            "x",
            "depth",
            "children"
          ]
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": "diagonal"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "cases",
      "type": "sqrt",
      "domain": [
        0,
        60000
      ],
      "range": [
        15,
        400
      ]
    },
    {
      "name": "hospital",
      "type": "sqrt",
      "domain": [
        0,
        2100
      ],
      "range": [
        15,
        400
      ]
    },
    {
      "name": "cost",
      "type": "sqrt",
      "domain": [
        0,
        30000000
      ],
      "range": [
        15,
        400
      ]
    },
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Cases reported (2024)",
        "Hospital stays (2022)",
        "Health spending (2018–19)"
      ],
      "range": [
        "#e34948",
        "#12304f",
        "#2a78d6"
      ]
    }
  ],
  "legends": [
    {
      "fill": "colour",
      "title": "What each circle shows",
      "orient": "none",
      "legendX": 0,
      "legendY": {
        "signal": "height - 90"
      },
      "symbolType": "circle",
      "symbolSize": 150,
      "symbolOpacity": 0.85,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "rowPadding": 6
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#cccccc"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "datum.kind == 'cases' || datum.kind == 'hospital' || datum.kind == 'cost' ? scale(datum.kind, datum.value || 0) : 60"
          },
          "fill": {
            "signal": "datum.kind == 'cases' ? '#e34948' : datum.kind == 'hospital' ? '#12304f' : datum.kind == 'cost' ? '#2a78d6' : '#888888'"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "tooltip": {
            "field": "label"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "field": "label"
          },
          "dx": {
            "signal": "datum.kind == 'root' ? 0 : datum.kind == 'disease' ? -8 : 14"
          },
          "dy": {
            "signal": "datum.kind == 'root' ? -14 : 0"
          },
          "align": {
            "signal": "datum.kind == 'disease' ? 'right' : 'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "datum.kind == 'disease' ? 13 : 11"
          },
          "fontWeight": {
            "signal": "datum.kind == 'disease' ? 'bold' : 'normal'"
          }
        }
      }
    }
  ]
}