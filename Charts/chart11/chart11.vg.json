{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Node-link tree of the health and economic burden of vaccine-preventable diseases in Australia.",
  "width": 960,
  "height": 640,
  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "title": {
    "text": "Beyond Infection: The Health and Economic Burden of Vaccine-Preventable Diseases",
    "subtitle": [
      "Cases reported (2024), hospital stays (2022) and health spending (2018–19) for each disease, Australia, all ages.",
      "Bigger red circle = more health spending. Orange = cases, dark red = hospital stays, blue = spending."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "offset": 12
  },
  "data": [
    {
      "name": "tree",
      "url": "../../data/burden_tree.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [
            {
              "signal": "height"
            },
            {
              "signal": "width - 260"
            }
          ],
          "separation": false,
          "as": [
            "y",
            "x",
            "depth",
            "children"
          ]
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": "diagonal"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "spend",
      "type": "sqrt",
      "domain": [
        0,
        30000000
      ],
      "range": [
        30,
        900
      ],
      "zero": true
    },
    {
      "name": "kind",
      "type": "ordinal",
      "domain": [
        "root",
        "disease",
        "cases",
        "hospital",
        "cost"
      ],
      "range": [
        "#12304f",
        "#e34948",
        "#f28e2b",
        "#a3261e",
        "#2a78d6"
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#c9c6bd"
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "datum.kind == 'disease' ? scale('spend', datum.value) : datum.kind == 'root' ? 180 : 45"
          },
          "fill": {
            "scale": "kind",
            "field": "kind"
          },
          "fillOpacity": {
            "signal": "datum.kind == 'disease' ? 0.85 : 1"
          },
          "stroke": {
            "value": "white"
          },
          "tooltip": {
            "field": "label"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "signal": "datum.kind == 'root' ? ['Vaccine-preventable', 'diseases'] : datum.label"
          },
          "dx": {
            "signal": "datum.kind == 'root' ? -6 : datum.kind == 'disease' ? 0 : 9"
          },
          "dy": {
            "signal": "datum.kind == 'disease' ? -14 : datum.kind == 'root' ? -14 : 0"
          },
          "align": {
            "signal": "datum.kind == 'root' ? 'left' : datum.kind == 'disease' ? 'center' : 'left'"
          },
          "baseline": {
            "signal": "datum.kind == 'disease' || datum.kind == 'root' ? 'bottom' : 'middle'"
          },
          "fontSize": {
            "signal": "datum.kind == 'disease' ? 12 : 11"
          },
          "fontWeight": {
            "signal": "datum.kind == 'disease' || datum.kind == 'root' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "datum.kind == 'disease' ? '#1a1a19' : datum.kind == 'root' ? '#12304f' : '#444444'"
          },
          "lineHeight": {
            "value": 13
          }
        }
      }
    }
  ]
}