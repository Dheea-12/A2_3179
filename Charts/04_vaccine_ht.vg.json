{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "All seven vaccines are below the 95% target",
    "subtitle": [
      "Percentage of Australian children covered for each vaccine (WHO/UNICEF estimates)."
    ],
    "anchor": "start"
  },
  "width": 720,
  "height": 260,
  "data": {
    "url": "data/wuenic_australia_antigens.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Coverage": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Year >= 2015"
    },
    {
      "calculate": "datum.Year == 2025 ? datum.Coverage : null",
      "as": "coverage_2025"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "coverage_2025",
          "as": "Coverage_in_2025"
        }
      ],
      "groupby": [
        "Vaccine"
      ]
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "Vaccine",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Coverage_in_2025",
        "op": "max",
        "order": "ascending"
      },
      "axis": {
        "labelLimit": 300,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "Coverage",
      "type": "quantitative",
      "title": "Coverage (%)",
      "scale": {
        "domain": [
          88,
          97
        ],
        "scheme": "blues",
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 220,
        "values": [
          88,
          90,
          92,
          94,
          96
        ]
      }
    },
    "tooltip": [
      {
        "field": "Vaccine",
        "type": "nominal"
      },
      {
        "field": "Year",
        "type": "ordinal"
      },
      {
        "field": "Coverage",
        "type": "quantitative",
        "title": "Children who received this vaccine(%)"
      }
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#12304f",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c5b57",
      "subtitlePadding": 6,
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#5c5b57",
      "titleColor": "#33322f",
      "gridColor": "#eeeeee"
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "header": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif"
    },
    "view": {
      "stroke": null
    }
  }
}
