{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "NSW and Queensland had the",
      "most whooping cough cases"
    ],
    "subtitle": [
      "Circle size = number of cases.",
      "Circle colour = cases per 100,000 people."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "view": {
    "stroke": null,
    "cornerRadius": 6
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4efe1",
        "stroke": "#b9b2a0",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": {
          "field": "properties.STATE_NAME",
          "type": "nominal",
          "title": "State"
        }
      }
    },
    {
      "data": {
        "url": "data/pertussis_state_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Cases": "number",
            "Rate_per_100k": "number",
            "lon": "number",
            "lat": "number",
            "Population": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.Rate_per_100k < 25 ? 'Under 25' : datum.Rate_per_100k < 50 ? '25 to 50' : datum.Rate_per_100k < 100 ? '50 to 100' : '100 or more'",
          "as": "rate_class"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.85,
            "stroke": "white",
            "strokeWidth": 1.2
          },
          "encoding": {
            "size": {
              "field": "Cases",
              "type": "quantitative",
              "title": "Cases (1 Jan to 19 Sep 2024)",
              "scale": {
                "type": "sqrt",
                "domain": [
                  0,
                  14000
                ],
                "range": [
                  0,
                  2200
                ]
              },
              "legend": {
                "orient": "bottom",
                "values": [
                  1000,
                  5000,
                  10000
                ],
                "format": ",.0f",
                "symbolFillColor": "#cccccc",
                "symbolStrokeColor": "white",
                "titleLimit": 220,
                "direction": "horizontal",
                "title": "Cases",
                "labelPadding": 2
              }
            },
            "color": {
              "field": "rate_class",
              "type": "ordinal",
              "title": "Cases per 100,000 people",
              "scale": {
                "domain": [
                  "Under 25",
                  "25 to 50",
                  "50 to 100",
                  "100 or more"
                ],
                "range": [
                  "#fcbba1",
                  "#fb6a4a",
                  "#de2d26",
                  "#a50f15"
                ]
              },
              "legend": {
                "orient": "top",
                "symbolType": "circle",
                "symbolSize": 150,
                "titleLimit": 220,
                "direction": "horizontal",
                "title": "Per 100,000 people"
              }
            },
            "order": {
              "field": "Cases",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "State_name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "Cases",
                "type": "quantitative",
                "title": "Cases",
                "format": ","
              },
              {
                "field": "Rate_per_100k",
                "type": "quantitative",
                "title": "Cases per 100,000",
                "format": ".1f"
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#12304f",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c5b57",
      "subtitlePadding": 6,
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#5c5b57",
      "titleColor": "#33322f",
      "gridColor": "#eeeeee"
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "header": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif"
    },
    "view": {
      "stroke": null
    }
  }
}
