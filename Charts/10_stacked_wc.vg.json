{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Whooping cough surged to",
      "a record in 2024"
    ],
    "subtitle": [
      "Cases reported in Australia each year, by age group.",
      "Click an age group in the legend to highlight it."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/pertussis_national_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Cases": "number"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "Age_pick",
          "select": {
            "type": "point",
            "fields": [
              "Age_group"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "datum.value % 2 == 0 ? datum.value : ''"
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "Cases",
          "type": "quantitative",
          "title": "Number of cases reported",
          "axis": {
            "format": ",.0f"
          }
        },
        "color": {
          "field": "Age_group",
          "type": "nominal",
          "title": "Age group (click to highlight)",
          "scale": {
            "domain": [
              "0–4 years",
              "5–14 years",
              "15 years and over"
            ],
            "range": [
              "#8F4054",
              "#D7838C",
              "#B5ADA6"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "labelLimit": 160
          }
        },
        "order": {
          "field": "Age_group",
          "sort": "ascending"
        },
        "opacity": {
          "condition": {
            "param": "Age_pick",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "Year",
            "title": "Year"
          },
          {
            "field": "Age_group",
            "title": "Age group"
          },
          {
            "field": "Cases",
            "type": "quantitative",
            "title": "Cases",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2024,
            "y": 57133,
            "t": "2024: 57,133 (record)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dx": -15,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#12304f"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2011,
            "y": 38743,
            "t": "38,743 (record)"
          },
          {
            "Year": 2021,
            "y": 3457,
            "t": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -8,
        "fontSize": 10,
        "color": "#555555"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#12304f",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c5b57",
      "subtitlePadding": 6,
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#5c5b57",
      "titleColor": "#33322f",
      "gridColor": "#eeeeee"
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "header": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif"
    },
    "view": {
      "stroke": null
    }
  }
}
