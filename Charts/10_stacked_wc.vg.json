{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Whooping cough surged to a record in 2024",
    "subtitle": [
      "Whooping cough (pertussis) cases reported in Australia each year, by age group, 2010–2024.",
      "School-age children (5–14) made up the largest group in 2024."
    ],
    "anchor": "start",
    "fontSize":25,
    "font":"sans-serif"
  },
  "width": 560,
  "height": 340,
  "data": {
    "url": "../data/pertussis_national_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Cases": "number"
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "Age_pick",
          "select": {
            "type": "point",
            "fields": ["Age_group"]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "Cases",
          "type": "quantitative",
          "title": "Number of cases reported",
          "axis": {"format": ",.0f"}
        },
        "color": {
          "field": "Age_group",
          "type": "nominal",
          "title": "Age group (click to highlight)",
          "scale": {
            "domain": ["0–4 years", "5–14 years", "15 years and over"],
            "range": ["#8F4054", "#D7838C", "#D7D2CE"]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "titleAlign": "left",
            "legendX":350,
            "legendY":-40
          }
        },
        "order": {
          "field": "Age_group",
          "sort": "ascending"
        },
        "opacity": {
          "condition": {"param": "Age_pick", "value": 1},
          "value": 0.15
        },
        "tooltip": [
          {"field": "Year", "title": "Year"},
          {"field": "Age_group", "title": "Age group"},
          {"field": "Cases", "type": "quantitative", "title": "Cases", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Year": 2024, "y": 57133, "t": "2024: 57,133 (record)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dx": -15,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#12304f"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "t"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": 2011, "y": 38743, "t": "38,743 (record)"},
          {"Year": 2021, "y": 3457, "t": "COVID-19"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -8,
        "fontSize": 10,
        "color": "#555555"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "t"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}