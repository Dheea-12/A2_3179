{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Lowest Coverage Doesn't Always Mean the Most Children",
    "subtitle": [
      "Number of children NOT fully immunised in each Primary Health Network region. Bigger circle = more children.",
      "The small maps zoom in on the capital cities, where most unprotected children live."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2017,
      "bind": {"input": "range", "min": 2013, "max": 2017, "step": 1, "name": "Financial year ending: "}
    },
    {
      "name": "Age_selection",
      "value": "2 years",
      "bind": {"input": "select", "options": ["1 year", "2 years", "5 years"], "name": "Age: "}
    }
  ],
  "hconcat": [
    {
      "width": 520,
      "height": 440,
      "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0]},
      "layer": [
        {
          "data": {"url": "data/phn_boundaries.topojson", "format": {"type": "topojson", "feature": "phn"}},
          "mark": {"type": "geoshape", "fill": "#eeeeee", "stroke": "white", "strokeWidth": 0.8}
        },
        {
          "data": {"url": "data/aus_states.topojson", "format": {"type": "topojson", "feature": "states"}},
          "mark": {"type": "geoshape", "filled": false, "stroke": "#b5b3ac", "strokeWidth": 1}
        },
        {
          "data": {
            "url": "data/TAB2_state_phn_clean.csv",
            "format": {
              "type": "csv",
              "parse": {
                "Not_fully_immunised": "number",
                "Registered_children": "number",
                "Percent_fully_immunised": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "(Year_selection - 1) + '-' + substring(toString(Year_selection), 2)",
              "as": "year_label"
            },
            {"filter": "datum.Age_group == Age_selection && datum.Reporting_Year == datum.year_label"},
            {
              "lookup": "PHN_code",
              "from": {
                "data": {"url": "data/phn_boundaries.topojson", "format": {"type": "topojson", "feature": "phn"}},
                "key": "properties.PHN_code"
              },
              "as": "geo"
            },
            {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "lon"},
            {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "lat"}
          ],
          "mark": {"type": "circle", "color": "#e34948", "opacity": 0.7, "stroke": "white", "strokeWidth": 1},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "Not_fully_immunised",
              "type": "quantitative",
              "title": "Children not fully immunised",
              "scale": {"domain": [0, 2500], "range": [0, 1100]},
              "legend": {
                "orient": "right",
                "values": [250, 1000, 2000],
                "symbolFillColor": "#e34948",
                "symbolOpacity": 0.7,
                "symbolStrokeColor": "white"
              }
            },
            "order": {"field": "Not_fully_immunised", "sort": "descending"},
            "tooltip": [
              {"field": "PHN_name", "type": "nominal", "title": "Region (PHN)"},
              {"field": "State", "type": "nominal"},
              {"field": "Reporting_Year", "type": "nominal", "title": "Year"},
              {
                "field": "Not_fully_immunised",
                "type": "quantitative",
                "title": "Not fully immunised",
                "format": ","
              },
              {
                "field": "Registered_children",
                "type": "quantitative",
                "title": "Registered children",
                "format": ","
              },
              {
                "field": "Percent_fully_immunised",
                "type": "quantitative",
                "title": "% fully immunised",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/TAB2_state_phn_clean.csv",
            "format": {
              "type": "csv",
              "parse": {
                "Not_fully_immunised": "number",
                "Registered_children": "number",
                "Percent_fully_immunised": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "(Year_selection - 1) + '-' + substring(toString(Year_selection), 2)",
              "as": "year_label"
            },
            {"filter": "datum.Age_group == Age_selection && datum.Reporting_Year == datum.year_label"},
            {
              "lookup": "PHN_code",
              "from": {
                "data": {"url": "data/phn_boundaries.topojson", "format": {"type": "topojson", "feature": "phn"}},
                "key": "properties.PHN_code"
              },
              "as": "geo"
            },
            {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "lon"},
            {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "lat"},
            {
              "window": [{"op": "rank", "as": "count_rank"}],
              "sort": [{"field": "Not_fully_immunised", "order": "descending"}]
            },
            {"filter": "datum.PHN_code == 'PHN701'"}
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#1a1a19"
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "PHN_name"}
          }
        }
      ]
