                    }
                  },
                  "transform": [
                    {
                      "calculate": "(Year_selection - 1) + '-' + substring(toString(Year_selection), 2)",
                      "as": "year_label"
                    },
                    {"filter": "datum.Age_group == Age_selection && datum.Reporting_Year == datum.year_label"},
                    {
                      "lookup": "PHN_code",
                      "from": {
                        "data": {
                          "url": "data/phn_boundaries.topojson",
                          "format": {"type": "topojson", "feature": "phn"}
                        },
                        "key": "properties.PHN_code"
                      },
                      "as": "geo"
                    },
                    {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "lon"},
                    {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "lat"},
                    {"filter": "indexof([\"PHN501\", \"PHN502\"], datum.PHN_code) >= 0"}
                  ],
                  "mark": {"type": "text", "fontSize": 10, "dy": 0, "color": "#1a1a19"},
                  "encoding": {
                    "longitude": {"field": "lon", "type": "quantitative"},
                    "latitude": {"field": "lat", "type": "quantitative"},
                    "text": {"field": "Not_fully_immunised", "type": "quantitative", "format": ","}
                  }
                }
              ]
            }
          ],
          "spacing": 12
        }
      ],
      "spacing": 12
    }
  ],
  "spacing": 20,
  "resolve": {"scale": {"size": "shared"}}
}