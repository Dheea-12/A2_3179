{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Node-link tree: vaccine-preventable diseases, sized by cases reported, each branching to its health spending.",
  "width": 960,
  "height": 520,
  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "title": {
    "text": "Health spending depends on diseases ",
    "subtitle": [
      "Circle size = cases reported in 2024. Each disease branches to its health spending in 2018–19. Australia, all ages.",
      "Diseases are ordered from highest to lowest health spending."
    ],
    "anchor": "start",
    "fontSize": 25,
    "font":"sans-serif",
    "offset": 12
  },
  "signals": [
    {
      "name": "barMax",
      "value": 220
    }
  ],
  "data": [
    {
      "name": "cases_only",
      "url": "../../data/burden_tree.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.kind == 'cases'"
        }
      ]
    },
    {
      "name": "tree",
      "url": "../../data/burden_tree.csv",
      "format": {
        "type": "csv",
        "parse": {
          "value": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.kind == 'root' || datum.kind == 'disease' || datum.kind == 'cost'"
        },
        {
          "type": "lookup",
          "from": "cases_only",
          "key": "parent",
          "fields": [
            "id"
          ],
          "values": [
            "value"
          ],
          "as": [
            "cases"
          ]
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": "cluster",
          "size": [
            {
              "signal": "height"
            },
            {
              "signal": "width - 560"
            }
          ],
          "separation": false,
          "as": [
            "y",
            "x",
            "depth",
            "children"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.x + 170",
          "as": "x"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "kind"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "kind_max"
          ]
        }
      ]
    },
    {
      "name": "spending",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.kind == 'cost'"
        }
      ]
    },
    {
      "name": "bands",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.kind == 'disease'"
        },
        {
          "type": "window",
          "sort": {
            "field": "y"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "band_no"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.band_no % 2 == 1"
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "filter",
          "expr": "datum.source.kind == 'root'"
        },
        {
          "type": "linkpath",
          "orient": "horizontal",
          "shape": "diagonal"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "cases",
      "type": "sqrt",
      "domain": [
        0,
        60000
      ],
      "range": [
        0,
        2200
      ],
      "zero": true
    }
  ],
  "legends": [
    {
      "size": "cases",
      "orient": "none",
      "legendX": 0,
      "legendY": 370,
      "title": "Cases reported in 2024",
      "symbolType": "circle",
      "symbolFillColor": "#e34948",
      "symbolStrokeColor": "white",
      "symbolOpacity": 0.85,
      "values": [
        1000,
        10000,
        50000
      ],
      "labelFontSize": 12,
      "titleFontSize": 12,
      "rowPadding": 8,
      "labelLimit": 300,
      "titleLimit": 300,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "format(datum.value, ',') + ' cases'"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "bands"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x - 40"
          },
          "x2": {
            "signal": "width + 10"
          },
          "y": {
            "signal": "datum.y - 26"
          },
          "y2": {
            "signal": "datum.y + 26"
          },
          "fill": {
            "value": "#f4f2ec"
          },
          "cornerRadius": {
            "value": 6
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#c9c6bd"
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "spending"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x + 8"
          },
          "x2": {
            "signal": "datum.x + 8 + barMax"
          },
          "yc": {
            "field": "y"
          },
          "height": {
            "value": 14
          },
          "fill": {
            "value": "#e9e6de"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "spending"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x + 8"
          },
          "x2": {
            "signal": "datum.x + 8 + datum.value / datum.kind_max * barMax"
          },
          "yc": {
            "field": "y"
          },
          "height": {
            "value": 14
          },
          "fill": {
            "value": "#2a78d6"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "cornerRadiusTopRight": {
            "value": 2
          },
          "cornerRadiusBottomRight": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "datum.kind == 'disease' ? max(scale('cases', datum.cases), 30) : datum.kind == 'root' ? 180 : 0"
          },
          "fill": {
            "signal": "datum.kind == 'root' ? '#12304f' : '#e34948'"
          },
          "fillOpacity": {
            "signal": "datum.kind == 'disease' ? 0.85 : 1"
          },
          "stroke": {
            "value": "white"
          },
          "tooltip": {
            "signal": "datum.kind == 'disease' ? {'Disease': datum.name, 'Cases reported (2024)': format(datum.cases, ',')} : datum.label"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "signal": "datum.kind == 'root' ? ['Vaccine-preventable', 'diseases'] : datum.kind == 'disease' ? [datum.name] : datum.label"
          },
          "dx": {
            "signal": "datum.kind == 'root' ? -6 : datum.kind == 'disease' ? 8 + sqrt(max(scale('cases', datum.cases), 30)) / 2 : barMax + 16"
          },
          "dy": {
            "signal": "datum.kind == 'root' ? -14 : 0"
          },
          "align": {
            "signal": "'left'"
          },
          "baseline": {
            "signal": "datum.kind == 'root' ? 'bottom' : 'middle'"
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "signal": "datum.kind == 'disease' ? 13 : 12"
          },
          "fontWeight": {
            "signal": "datum.kind == 'cost' && datum.value != datum.kind_max ? 'normal' : 'bold'"
          },
          "fill": {
            "signal": "datum.kind == 'root' ? '#12304f' : datum.kind == 'disease' ? '#1a1a19' : (datum.value == datum.kind_max ? '#2a78d6' : '#555555')"
          }
        }
      }
    }
  ]
}