{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped adjacency matrix: which serious outcomes each vaccine-preventable disease can lead to.",
  "title": {
    "text": [
      "Every one of these diseases can kill, and most",
      "can cause pneumonia or brain damage"
    ],
    "subtitle": [
      "Tick = the disease can cause that outcome.",
      "Same disease order as the spending chart. Hover for details."
    ],
    "anchor": "start",
    "offset": 14
  },
  "data": {
    "url": "data/disease_outcome_matrix.csv",
    "format": {
      "type": "csv"
    }
  },
  "facet": {
    "row": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Lungs and breathing",
        "Brain and nerves",
        "Rest of the body",
        "Death"
      ],
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelAlign": "left",
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelColor": "#12304f",
        "labelPadding": 4,
        "labelExpr": "datum.value == 'Death' ? 'Most serious outcome' : datum.value"
      }
    }
  },
  "spacing": 14,
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spec": {
    "width": {
      "step": 92
    },
    "height": {
      "step": 34
    },
    "layer": [
      {
        "mark": {
          "type": "rect",
          "stroke": "#ffffff",
          "strokeWidth": 3,
          "cornerRadius": 4
        },
        "encoding": {
          "x": {
            "field": "disease_short",
            "type": "nominal",
            "sort": [
              "Pneumococcal",
              "Hib",
              "Whooping cough",
              "Chickenpox",
              "Rotavirus",
              "Meningococcal",
              "Measles",
              "Diphtheria"
            ],
            "title": null,
            "axis": {
              "orient": "top",
              "labelAngle": 0,
              "labelFontSize": 12,
              "labelFontWeight": "bold",
              "labelColor": "#1a1a19",
              "domain": false,
              "ticks": false,
              "labelPadding": 6
            }
          },
          "y": {
            "field": "outcome",
            "type": "nominal",
            "sort": [
              "Pneumonia (lung infection)",
              "Blocked airway or stopped breathing",
              "Meningitis",
              "Brain damage",
              "Seizures",
              "Blood infection (sepsis)",
              "Ear infection or deafness",
              "Skin, joint or limb damage",
              "Severe diarrhoea or dehydration",
              "Heart or nerve damage",
              "Death"
            ],
            "title": null,
            "axis": {
              "labelFontSize": 12,
              "labelLimit": 260,
              "domain": false,
              "ticks": false,
              "labelPadding": 8
            }
          },
          "color": {
            "field": "kind",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "Complication",
                "Death",
                "None"
              ],
              "range": [
                "#E3E7EC",
                "#12304F",
                "#F6F5F1"
              ]
            }
          },
          "tooltip": [
            {
              "field": "disease",
              "type": "nominal",
              "title": "Disease"
            },
            {
              "field": "outcome",
              "type": "nominal",
              "title": "Outcome"
            },
            {
              "field": "detail",
              "type": "nominal",
              "title": "Detail"
            },
            {
              "field": "source",
              "type": "nominal",
              "title": "Source"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.linked == 'Yes'"
          }
        ],
        "mark": {
          "type": "text",
          "text": "✓",
          "fontSize": 18,
          "fontWeight": "bold"
        },
        "encoding": {
          "x": {
            "field": "disease_short",
            "type": "nominal",
            "sort": [
              "Pneumococcal",
              "Hib",
              "Whooping cough",
              "Chickenpox",
              "Rotavirus",
              "Meningococcal",
              "Measles",
              "Diphtheria"
            ]
          },
          "y": {
            "field": "outcome",
            "type": "nominal",
            "sort": [
              "Pneumonia (lung infection)",
              "Blocked airway or stopped breathing",
              "Meningitis",
              "Brain damage",
              "Seizures",
              "Blood infection (sepsis)",
              "Ear infection or deafness",
              "Skin, joint or limb damage",
              "Severe diarrhoea or dehydration",
              "Heart or nerve damage",
              "Death"
            ]
          },
          "color": {
            "condition": {
              "test": "datum.outcome == 'Death'",
              "value": "#FFFFFF"
            },
            "value": "#12304F"
          },
          "tooltip": [
            {
              "field": "disease",
              "type": "nominal",
              "title": "Disease"
            },
            {
              "field": "outcome",
              "type": "nominal",
              "title": "Outcome"
            },
            {
              "field": "detail",
              "type": "nominal",
              "title": "Detail"
            },
            {
              "field": "source",
              "type": "nominal",
              "title": "Source"
            }
          ]
        }
      }
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": 600,
      "color": "#12304f",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c5b57",
      "subtitlePadding": 6,
      "anchor": "start",
      "offset": 12
    },
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#333333",
      "titleColor": "#33322f",
      "gridColor": "#eeeeee"
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "header": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif"
    },
    "view": {
      "stroke": null
    }
  }
}
