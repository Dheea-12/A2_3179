{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Childhood Immunisation Coverage in Australia Over time",
    "subtitle": [
      " 3 doses of the DTP vaccine (diphtheria, tetanus and whooping cough) is a global indicator to show that no zero unvaccinated child, 2010–2025.",
      "WHO/UNICEF estimates."
    ],
    "anchor": "start"
  },
  "width": 900,
  "height": 330,
  "layer": [
    {
      "data": {
        "url": "../../data/dtp3_australia_peer_band_fixed.csv",
        "format": {"type": "csv", "parse": {"Year": "number", "Coverage": "number"}}
      },
      "transform": [{"filter": "datum.Country == 'Australia'"}],
      "mark": {"type": "line", "color": "#12304f", "strokeWidth": 3, "point": {"size": 60, "color": "#12304f"}},
      "encoding": {
        "x": {"field": "Year", "type": "quantitative", "title": null, "scale": {"domain": [2010, 2025]},
              "axis": {"format": "d", "grid": false, "tickCount": 16}},
        "y": {"field": "Coverage", "type": "quantitative", "title": "% of one-year-olds (DTP3)",
              "scale": {"domain": [88, 97]}},
        "tooltip": [
          {"field": "Year", "type": "quantitative", "format": "d"},
          {"field": "Coverage", "type": "quantitative", "title": "DTP3 coverage (%)"}
        ]
      }
    },
    {
      "data": {"values": [{"start": 2017, "end": 2021}]},
      "mark": {"type": "rect", "color": "#2a78d6", "opacity": 0.08},
      "encoding": {
        "x": {"field": "start", "type": "quantitative", "scale": {"domain": [2010, 2025]}},
        "x2": {"field": "end"}
      }
    },
    {
      "data": {"values": [{"x": 2019, "y": 96.6, "label": "At the 95% target for 5 years (2017–2021)"}]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#1f5fae"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [2010, 2025]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [88, 97]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"y": 95}]},
      "mark": {"type": "rule", "strokeDash": [5, 4], "color": "#888"},
      "encoding": {
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [88, 97]}}
      }
    },
    {
      "data": {"values": [{"x": 2010.1, "y": 95, "label": "95% national target"}]},
      "mark": {"type": "text", "align": "left", "dy": -7, "fontSize": 11, "color": "#666"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [2010, 2025]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [88, 97]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"x": 2016}, {"x": 2020}]},
      "mark": {"type": "rule", "strokeDash": [2, 3], "color": "#aaa"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [2010, 2025]}}
      }
    },
    {
      "data": {"values": [{"x": 2016, "label": "2016: No Jab No Pay"}, {"x": 2020, "label": "2020: COVID-19"}]},
      "mark": {"type": "text", "align": "left", "dx": 4, "y": 318, "fontSize": 10, "color": "#777"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [2010, 2025]}},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": [{"x": 2025, "y": 92, "label": "92% in 2025"}]},
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 13, "fontWeight": "bold", "color": "#e34948"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [2010, 2025]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [88, 97]}},
        "text": {"field": "label"}
      }
    }
  ]
}