{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Are Regional Gaps Closing or Widening?",
    "subtitle": [
      "% of children fully immunised in each of Australia's ~330 local areas (SA3), 2011–12 to 2016–17",
      "Wider shape = more local areas at that level. Dark line = typical (median) area. Red dashed line = 95% target."
    ],
    "anchor": "start",
    "subtitleColor": "#555555"
  },
  "params": [
    {
      "name": "Age_selection",
      "value": "2 years",
      "bind": {
        "input": "select",
        "options": [
          "1 year",
          "2 years",
          "5 years"
        ],
        "name": "Age: "
      }
    }
  ],
  "data": {
    "url": "../../data/TAB3_sa3_clean.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Percent_fully_immunised": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Age_group == Age_selection && isValid(datum.Percent_fully_immunised)"
    }
  ],
  "facet": {
    "column": {
      "field": "Reporting_Year",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelOrient": "bottom",
        "labelFontSize": 12,
        "labelPadding": 6
      }
    }
  },
  "spacing": 0,
  "spec": {
    "width": 105,
    "height": 380,
    "layer": [
      {
        "transform": [
          {
            "density": "Percent_fully_immunised",
            "groupby": [
              "Reporting_Year"
            ],
            "extent": [
              70,
              100
            ],
            "bandwidth": 0.8
          }
        ],
        "mark": {
          "type": "area",
          "orient": "horizontal",
          "color": "#6baed6",
          "opacity": 0.85
        },
        "encoding": {
          "y": {
            "field": "value",
            "type": "quantitative",
            "title": "% fully immunised",
            "scale": {
              "domain": [
                70,
                100
              ],
              "nice": false
            }
          },
          "x": {
            "field": "density",
            "type": "quantitative",
            "stack": "center",
            "impute": null,
            "title": null,
            "axis": null
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "y": 95
            }
          ]
        },
        "mark": {
          "type": "rule",
          "color": "#e34948",
          "strokeDash": [
            5,
            4
          ]
        },
        "encoding": {
          "y": {
            "field": "y",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "median",
                "field": "Percent_fully_immunised",
                "as": "median"
              }
            ],
            "groupby": [
              "Reporting_Year"
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "align": "center",
          "color": "#12304f",
          "strokeWidth": 3,
          "x": 8,
          "x2": 75
        },
        "encoding": {
          "y": {
            "field": "median",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "Reporting_Year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "median",
              "type": "quantitative",
              "title": "Median local area (%)",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "median",
                "field": "Percent_fully_immunised",
                "as": "median"
              }
            ],
            "groupby": [
              "Reporting_Year"
            ]
          },
          {
            "calculate": "format(datum.median, '.1f') + '%'",
            "as": "median_label"
          }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "dy": -9,
          "x": 45,
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#12304f"
        },
        "encoding": {
          "y": {
            "field": "median",
            "type": "quantitative"
          },
          "text": {
            "field": "median_label"
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}