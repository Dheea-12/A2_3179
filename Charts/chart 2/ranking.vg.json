{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia sits at #4 rank across 7 developed countries",
    "subtitle": [
      "DTP3 vaccine coverage ranking among 7 developed countries (1 = highest coverage), 2010–2025.",
      "Countries with the same coverage are ordered by their WHO/UNICEF world rank."
    ],
    "anchor": "start",
    "subtitleColor": "#555555"
  },
  "width": 620,
  "height": 340,
  "data": {
    "url": "../../data/dtp3_peer_rank_7.csv",
    "format": {"type": "csv", "parse": {"Year": "number", "Coverage": "number", "Rank": "number"}}
  },
  "transform": [
    {"calculate": "datum.Country == 'United States of America' ? 'United States' : datum.Country", "as": "Name"},
    {"calculate": "datum.Name == 'Australia' ? 1 : 0", "as": "highlight"}
  ],
  "encoding": {
    "x": {
      "field": "Year", "type": "quantitative", "title": null,
      "scale": {"domain": [2010, 2025]},
      "axis": {"format": "d", "tickCount": 16, "grid": false, "labelAngle": 0}
    },
    "y": {
      "field": "Rank", "type": "quantitative", "title": "Rank among the 7 countries (1 = best)",
      "scale": {"domain": [1, 7], "reverse": true},
      "axis": {"values": [1, 2, 3, 4, 5, 6, 7], "grid": true}
    },
    "detail": {"field": "Name"},
    "order": {"field": "highlight"},
    "color": {
      "field": "Name", "type": "nominal",
      "scale": {
        "domain": ["Australia", "Italy", "United States", "Spain", "Japan", "Slovenia", "Lithuania"],
        "range": ["#e31a1c", "#1f6fff", "#ff8c00", "#8c564b", "#8e44ad", "#00b5c8", "#e6007e"]
      },
      "legend": null
    },
    "opacity": {"condition": {"test": "datum.highlight == 1", "value": 1}, "value": 0.55}
  },
  "layer": [
    {
      "mark": {"type": "line"},
      "encoding": {
        "strokeWidth": {"condition": {"test": "datum.highlight == 1", "value": 3.5}, "value": 2}
      }
    },
    {
      "mark": {"type": "circle"},
      "encoding": {
        "size": {"condition": {"test": "datum.highlight == 1", "value": 70}, "value": 35},
        "tooltip": [
          {"field": "Name", "type": "nominal", "title": "Country"},
          {"field": "Year", "type": "quantitative", "format": "d"},
          {"field": "Rank", "type": "quantitative", "title": "Rank among 7 countries"},
          {"field": "Coverage", "type": "quantitative", "title": "DTP3 coverage (%)"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.Year == 2025"},
        {"calculate": "'#' + datum.Rank + ' ' + datum.Name", "as": "end_label"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 8, "fontSize": 12, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "end_label"},
        "opacity": {"value": 1}
      }
    },
    {
      "transform": [
        {"filter": "datum.Name == 'Australia' && datum.Year == 2013"},
        {"calculate": "'#' + datum.Rank + ' in ' + datum.Year", "as": "point_label"}
      ],
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "fontWeight": "bold", "color": "#a3261e"},
      "encoding": {"text": {"field": "point_label"}}
    },
    {
      "transform": [
        {"filter": "datum.Name == 'Australia' && datum.Year == 2021"},
        {"calculate": "'#' + datum.Rank + ' in ' + datum.Year", "as": "point_label"}
      ],
      "mark": {"type": "text", "dy": -14, "fontSize": 11, "fontWeight": "bold", "color": "#a3261e"},
      "encoding": {"text": {"field": "point_label"}}
    }
  ],
  "padding": {"right": 120, "left": 5, "top": 5, "bottom": 5}
}