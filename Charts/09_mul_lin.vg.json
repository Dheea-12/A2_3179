{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Hospital admissions fell sharply after free vaccines were introduced",
    "subtitle": [
      "Hospital admissions per million children in the youngest age group reported for each disease, Australia, 1999–2022.",
      "Each panel has its own scale. The dashed line marks when a free vaccine started for all children."
    ],
    "anchor": "start"
  },
  "data": {
    "url": "data/hospitalisations_children.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Rate_per_million": "number",
        "Vaccine_start": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Disease + ' (' + datum.Age_group + ')'",
      "as": "Panel"
    },
    {
      "calculate": "indexof(['Rotavirus', 'Chickenpox', 'Pneumococcal disease', 'Whooping cough', 'Measles', 'Hib'], datum.Disease)",
      "as": "panel_order"
    }
  ],
  "facet": {
    "field": "Panel",
    "type": "nominal",
    "title": null,
    "sort": {
      "field": "panel_order",
      "op": "min"
    },
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelAnchor": "start"
    }
  },
  "columns": 3,
  "spec": {
    "width": 240,
    "height": 150,
    "layer": [
      {
        "transform": [
          {
            "filter": "isValid(datum.Vaccine_start) && datum.Year == datum.Vaccine_start"
          }
        ],
        "layer": [
          {
            "mark": {
              "type": "rule",
              "color": "#2a78d6",
              "strokeDash": [
                4,
                3
              ],
              "strokeWidth": 1.5
            },
            "encoding": {
              "x": {
                "field": "Year",
                "type": "quantitative",
                "scale": {
                  "domain": [
                    1999,
                    2022
                  ]
                }
              }
            }
          },
          {
            "mark": {
              "type": "text",
              "align": "left",
              "dx": 4,
              "y": 8,
              "fontSize": 10,
              "color": "#2a78d6"
            },
            "encoding": {
              "x": {
                "field": "Year",
                "type": "quantitative",
                "scale": {
                  "domain": [
                    1999,
                    2022
                  ]
                }
              },
              "text": {
                "value": "free vaccine"
              }
            }
          }
        ]
      },
      {
        "transform": [
          {
            "filter": "isValid(datum.Rate_per_million)"
          }
        ],
        "mark": {
          "type": "area",
          "color": "#B39A45",
          "opacity": 0.15,
          "line": {
            "color": "#B39A45",
            "strokeWidth": 2
          }
        },
        "encoding": {
          "x": {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "scale": {
              "domain": [
                1999,
                2022
              ]
            },
            "axis": {
              "format": "d",
              "values": [
                2000,
                2005,
                2010,
                2015,
                2020
              ],
              "grid": false
            }
          },
          "y": {
            "field": "Rate_per_million",
            "type": "quantitative",
            "title": "Per million",
            "axis": {
              "format": ",.0f",
              "tickCount": 4
            }
          },
          "tooltip": [
            {
              "field": "Disease",
              "type": "nominal"
            },
            {
              "field": "Age_group",
              "type": "nominal",
              "title": "Age group"
            },
            {
              "field": "Year",
              "type": "quantitative",
              "format": "d"
            },
            {
              "field": "Rate_per_million",
              "type": "quantitative",
              "title": "Hospitalisations per million",
              "format": ",.0f"
            }
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "spacing": {
    "row": 30,
    "column": 25
  }
}