{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Indigenous Gap Has Nearly Closed, Except at Age 2",
    "subtitle": [
      "% fully immunised, Aboriginal and Torres Strait Islander vs non-Indigenous children.",
      "Faded dots = 2012–13, solid dots = 2016–17."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": 620,
  "height": 360,
  "data": {
    "url": "../../data/TAB1_national_clean.csv",
    "format": {
      "type": "csv",
      "parse": {
        "All_registered": "number",
        "All_fully_immunised": "number",
        "Indig_registered": "number",
        "Indig_fully_immunised": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "indexof(['2012–13', '2016–17'], datum.Reporting_Year) >= 0"
    },
    {
      "calculate": "datum.Indig_fully_immunised / datum.Indig_registered * 100",
      "as": "Indigenous"
    },
    {
      "calculate": "(datum.All_fully_immunised - datum.Indig_fully_immunised) / (datum.All_registered - datum.Indig_registered) * 100",
      "as": "Non-Indigenous"
    },
    {
      "calculate": "datum['Non-Indigenous'] - datum.Indigenous",
      "as": "gap"
    },
    {
      "calculate": "datum.gap >= 0 ? 'Gap: ' + format(datum.gap, '.1f') + ' pts' : 'Indigenous ahead by ' + format(-datum.gap, '.1f')",
      "as": "gap_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "Age_group",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelFontWeight": "bold"
      }
    },
    "yOffset": {
      "field": "Reporting_Year",
      "type": "nominal",
      "sort": [
        "2012–13",
        "2016–17"
      ]
    },
    "opacity": {
      "field": "Reporting_Year",
      "type": "ordinal",
      "scale": {
        "domain": [
          "2012–13",
          "2016–17"
        ],
        "range": [
          0.35,
          1
        ]
      },
      "legend": {
        "title": "Year",
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#999",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Indigenous",
          "type": "quantitative",
          "scale": {
            "domain": [
              84,
              98
            ]
          },
          "title": "% fully immunised"
        },
        "x2": {
          "field": "Non-Indigenous"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "Indigenous",
            "Non-Indigenous"
          ],
          "as": [
            "Group",
            "Percent"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "size": 150
      },
      "encoding": {
        "x": {
          "field": "Percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              84,
              98
            ]
          }
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Indigenous",
              "Non-Indigenous"
            ],
            "range": [
              "#d9822b",
              "#2a78d6"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "Age_group",
            "title": "Age"
          },
          {
            "field": "Reporting_Year",
            "title": "Year"
          },
          {
            "field": "Group"
          },
          {
            "field": "Percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "% fully immunised"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "color": "#444"
      },
      "encoding": {
        "x": {
          "datum": 96.2,
          "type": "quantitative",
          "scale": {
            "domain": [
              84,
              98
            ]
          }
        },
        "text": {
          "field": "gap_label"
        }
      }
    }
  ]
}