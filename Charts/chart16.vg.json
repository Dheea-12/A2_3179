{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Adjacency matrix with marginal bars: which serious outcomes each vaccine-preventable disease can lead to.",
  "title": {
    "text": "Many vaccine-preventable diseases can lead to pneumonia, brain damage or death",
    "subtitle": [
      "A filled square means the disease can cause that outcome. Bars show how many outcomes each disease can cause, and how many diseases cause each outcome.",
      "Hover over a square to highlight its row and column, and to see details and the source."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "offset": 14
  },
  "data": {
    "url": "../data/disease_outcome_matrix.csv",
    "format": {
      "type": "csv"
    }
  },
  "spacing": 6,
  "vconcat": [
    {
      "width": {
        "step": 52
      },
      "height": 70,
      "transform": [
        {
          "filter": "datum.linked == 'Yes'"
        }
      ],
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.7
        },
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "outcome",
          "type": "nominal",
          "sort": [
            "Pneumonia (lung infection)",
            "Brain damage",
            "Meningitis",
            "Blocked airway or stopped breathing",
            "Ear infection or deafness",
            "Skin, joint or limb damage",
            "Blood infection (sepsis)",
            "Severe diarrhoea or dehydration",
            "Seizures",
            "Heart or nerve damage",
            "Death"
          ],
          "axis": null
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Diseases",
          "axis": {
            "tickCount": 3,
            "grid": false,
            "titleFontWeight": "normal",
            "titleColor": "#777777"
          }
        },
        "color": {
          "condition": {
            "test": "datum.outcome == 'Death'",
            "value": "#12304f"
          },
          "value": "#de2d26"
        },
        "tooltip": [
          {
            "field": "outcome",
            "type": "nominal",
            "title": "Outcome"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Diseases that can cause it"
          }
        ]
      }
    },
    {
      "spacing": 6,
      "hconcat": [
        {
          "width": {
            "step": 52
          },
          "height": {
            "step": 40
          },
          "params": [
            {
              "name": "hover_row",
              "select": {
                "type": "point",
                "fields": [
                  "disease"
                ],
                "on": "mouseover",
                "clear": "mouseout"
              }
            },
            {
              "name": "hover_col",
              "select": {
                "type": "point",
                "fields": [
                  "outcome"
                ],
                "on": "mouseover",
                "clear": "mouseout"
              }
            }
          ],
          "mark": {
            "type": "rect",
            "stroke": "#ffffff",
            "strokeWidth": 3,
            "cornerRadius": 4
          },
          "encoding": {
            "x": {
              "field": "outcome",
              "type": "nominal",
              "sort": [
                "Pneumonia (lung infection)",
                "Brain damage",
                "Meningitis",
                "Blocked airway or stopped breathing",
                "Ear infection or deafness",
                "Skin, joint or limb damage",
                "Blood infection (sepsis)",
                "Severe diarrhoea or dehydration",
                "Seizures",
                "Heart or nerve damage",
                "Death"
              ],
              "title": null,
              "axis": {
                "orient": "bottom",
                "labelAngle": -40,
                "labelAlign": "right",
                "labelFontSize": 12,
                "labelLimit": 220,
                "domain": false,
                "ticks": false
              }
            },
            "y": {
              "field": "disease",
              "type": "nominal",
              "sort": [
                "Meningococcal disease",
                "Hib",
                "Pneumococcal disease",
                "Whooping cough",
                "Measles",
                "Chickenpox",
                "Diphtheria",
                "Rotavirus"
              ],
              "title": null,
              "axis": {
                "labelFontSize": 13,
                "labelFontWeight": "bold",
                "domain": false,
                "ticks": false,
                "labelPadding": 8
              }
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Complication",
                  "Death",
                  "None"
                ],
                "range": [
                  "#de2d26",
                  "#12304f",
                  "#f1efe9"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "values": [
                  "Complication",
                  "Death"
                ],
                "labelExpr": "datum.label == 'Complication' ? 'Can lead to this' : 'Can cause death'",
                "symbolType": "square",
                "symbolSize": 160
              }
            },
            "opacity": {
              "condition": {
                "test": {
                  "or": [
                    {
                      "param": "hover_row",
                      "empty": true
                    },
                    {
                      "param": "hover_col",
                      "empty": false
                    }
                  ]
                },
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "disease",
                "type": "nominal",
                "title": "Disease"
              },
              {
                "field": "outcome",
                "type": "nominal",
                "title": "Outcome"
              },
              {
                "field": "detail",
                "type": "nominal",
                "title": "Detail"
              },
              {
                "field": "source",
                "type": "nominal",
                "title": "Source"
              }
            ]
          }
        },
        {
          "width": 90,
          "height": {
            "step": 40
          },
          "transform": [
            {
              "filter": "datum.linked == 'Yes'"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "bar",
                "height": {
                  "band": 0.6
                },
                "color": "#de2d26",
                "cornerRadiusTopRight": 2,
                "cornerRadiusBottomRight": 2
              },
              "encoding": {
                "y": {
                  "field": "disease",
                  "type": "nominal",
                  "sort": [
                    "Meningococcal disease",
                    "Hib",
                    "Pneumococcal disease",
                    "Whooping cough",
                    "Measles",
                    "Chickenpox",
                    "Diphtheria",
                    "Rotavirus"
                  ],
                  "axis": null
                },
                "x": {
                  "aggregate": "count",
                  "type": "quantitative",
                  "title": "Outcomes",
                  "axis": {
                    "tickCount": 3,
                    "grid": false,
                    "orient": "top",
                    "titleFontWeight": "normal",
                    "titleColor": "#777777"
                  }
                },
                "tooltip": [
                  {
                    "field": "disease",
                    "type": "nominal",
                    "title": "Disease"
                  },
                  {
                    "aggregate": "count",
                    "type": "quantitative",
                    "title": "Serious outcomes it can cause"
                  }
                ]
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 11,
                "color": "#555555"
              },
              "encoding": {
                "y": {
                  "field": "disease",
                  "type": "nominal",
                  "sort": [
                    "Meningococcal disease",
                    "Hib",
                    "Pneumococcal disease",
                    "Whooping cough",
                    "Measles",
                    "Chickenpox",
                    "Diphtheria",
                    "Rotavirus"
                  ]
                },
                "x": {
                  "aggregate": "count",
                  "type": "quantitative"
                },
                "text": {
                  "aggregate": "count",
                  "type": "quantitative"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#333333"
    }
  }
}