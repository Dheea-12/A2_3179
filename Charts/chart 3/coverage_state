{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "params": [
    {
      "name": "Year_selection",
      "value": 2017,
      "bind": {
        "input": "range",
        "min": 2014,
        "max": 2017,
        "step": 1,
        "name": "Financial year ending: "
      }
    },
    {
      "name": "Age_selection",
      "value": "2 years",
      "bind": {
        "input": "select",
        "options": ["1 year", "2 years", "5 years"],
        "name": "Age: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/phn_boundaries.topojson",
        "format": {"type": "topojson", "feature": "phn"}
      },
      "transform": [
        {
          "calculate": "'Data is not available for ' + datum.properties.PHN_NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {"tooltip": {"field": "note"}}
    },
    {
      "data": {
        "url": "data/phn_coverage_wide.csv"
      },
      "transform": [
        {"filter": "datum.Age_group == Age_selection"},
        {
          "lookup": "PHN_code",
          "from": {
            "data": {
              "url": "data/phn_boundaries.topojson",
              "format": {"type": "topojson", "feature": "phn"}
            },
            "key": "properties.PHN_code"
          },
          "as": "geo"
        },
        {"calculate": "toNumber(datum[Year_selection])", "as": "year_coverage"},
        {"calculate": "datum.year_coverage - toNumber(datum['2013'])", "as": "change"},
        {"calculate": "(Year_selection - 1) + '–' + substring(toString(Year_selection), 2)", "as": "year_label"}
      ],
      "mark": {"type": "geoshape", "stroke": "#fff", "strokeWidth": 0.8},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "change",
          "type": "quantitative",
          "title": "Change since 2012–13 (points)",
          "scale": {
            "domain": [-6, 6],
            "domainMid": 0,
            "scheme": "redblue",
            "clamp": true
          },
          "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 200, "values": [-6, -3, 0, 3, 6]}
        },
        "tooltip": [
          {"field": "PHN_name", "type": "nominal", "title": "Region (PHN)"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "year_label", "type": "nominal", "title": "Year"},
          {"field": "year_coverage", "type": "quantitative", "title": "% fully immunised", "format": ".1f"},
          {"field": "2013", "type": "quantitative", "title": "% in 2012–13", "format": ".1f"},
          {"field": "change", "type": "quantitative", "title": "Change (points)", "format": "+.1f"}
        ]
      }
    }
  ],
  "config": {}
}