{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "68,159 children were not fully immunised in 2016–17",
    "subtitle": "Every registered child aged 1, 2 and 5 in Australia, 2016–17. Band width = number of children.",
    "anchor": "start"
  },
  "width": 940,
  "height": 420,
  "data": {
    "url": "data/sankey_children_nodes.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "x": "number",
        "x2": "number",
        "y": "number",
        "y2": "number"
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/sankey_children_links.csv",
        "format": {
          "type": "csv",
          "parse": {
            "value": "number",
            "x": "number",
            "y": "number",
            "y2": "number"
          }
        }
      },
      "mark": {
        "type": "area",
        "interpolate": "linear"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              760
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              420
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        },
        "detail": {
          "field": "link",
          "type": "nominal"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "cohort",
              "fully",
              "not"
            ],
            "range": [
              "#E4E1DC",
              "#718C82",
              "#B87949"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "datum.kind == 'not'",
            "value": 0.9
          },
          "value": 0.6
        },
        "tooltip": [
          {
            "field": "source",
            "type": "nominal",
            "title": "From"
          },
          {
            "field": "target",
            "type": "nominal",
            "title": "To"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Children",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "total",
              "age",
              "fully",
              "not"
            ],
            "range": [
              "#12304f",
              "#5c6b7a",
              "#718C82",
              "#B87949"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Children",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'total'"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "ym"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "All registered"
          ]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'age'"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "ym"
        },
        {
          "calculate": "[datum.label]",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": "bold",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "x2",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind == 'fully' || datum.kind == 'not'"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "ym"
        },
        {
          "calculate": "[datum.label,'(' + format(datum.value / 938484, '.1%') + ')' ]",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "field": "x2",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.kind == 'not'",
            "value": "#a3261e"
          },
          "value": "#1a1a19"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}