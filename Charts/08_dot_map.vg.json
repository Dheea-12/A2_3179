{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most children who missed out live in and around the big cities",
    "subtitle": [
      "Children not fully immunised. Each dot = 20 children, placed at random inside their local area (SA3), not at real addresses.",
      "Choose a map centre, then drag the Zoom slider to look closer. Hover a dot for details."
    ],
    "anchor": "start"
  },
  "width": 900,
  "height": 540,
  "params": [
    {
      "name": "Year_selection",
      "value": "2016-17",
      "bind": {
        "input": "select",
        "options": [
          "2011-12",
          "2012-13",
          "2013-14",
          "2014-15",
          "2015-16",
          "2016-17"
        ],
        "name": "Year: "
      }
    },
    {
      "name": "Age_selection",
      "value": "2 years",
      "bind": {
        "input": "select",
        "options": [
          "1 year",
          "2 years",
          "5 years"
        ],
        "name": "Age: "
      }
    },
    {
      "name": "zoom_level",
      "value": 900,
      "bind": {
        "input": "range",
        "min": 900,
        "max": 20000,
        "step": 100,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        2,
        -27.5
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            2,
            -27.5
          ],
          [
            19.0,
            -33.85
          ],
          [
            13.0,
            -37.85
          ],
          [
            21.0,
            -27.55
          ],
          [
            -16.1,
            -32.0
          ],
          [
            6.6,
            -34.9
          ],
          [
            -1.2,
            -12.5
          ],
          [
            15.0,
            -42.0
          ]
        ],
        "labels": [
          "All of Australia",
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Perth",
          "Adelaide",
          "Darwin",
          "Tasmania"
        ],
        "name": "Map centre: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": {
      "expr": "center_to"
    },
    "scale": {
      "expr": "zoom_level"
    },
    "translate": [
      450,
      270
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/sa3_boundaries.topojson",
        "format": {
          "type": "topojson",
          "feature": "sa3"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeece6",
        "stroke": "#ffffff",
        "strokeWidth": {
          "expr": "zoom_level < 3000 ? 0.5 : 1.2"
        },
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/sa3_density.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.Reporting_Year == Year_selection && datum.Age_group == Age_selection"
        },
        {
          "calculate": "'1 dot = 20 children not fully immunised'",
          "as": "key"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "size": {
          "expr": "zoom_level < 3000 ? 14 : 45"
        },
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "key",
          "type": "nominal",
          "title": null,
          "scale": {
            "range": [
              "#B87949"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 0,
            "symbolType": "circle",
            "symbolSize": 60,
            "symbolOpacity": 1,
            "labelLimit": 300,
            "fillColor": "rgba(255,255,255,0.85)",
            "padding": 6
          }
        },
        "tooltip": [
          {
            "field": "SA3_name",
            "title": "Local area (SA3)"
          },
          {
            "field": "State",
            "title": "State"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "lat": -33.87,
            "lon": 151.21
          },
          {
            "city": "Brisbane",
            "lat": -27.47,
            "lon": 153.03
          },
          {
            "city": "Hobart",
            "lat": -42.88,
            "lon": 147.33
          },
          {
            "city": "Cairns",
            "lat": -16.92,
            "lon": 145.77
          },
          {
            "city": "Melbourne",
            "lat": -37.81,
            "lon": 144.96
          },
          {
            "city": "Perth",
            "lat": -31.95,
            "lon": 115.86
          },
          {
            "city": "Adelaide",
            "lat": -34.93,
            "lon": 138.6
          },
          {
            "city": "Darwin",
            "lat": -12.46,
            "lon": 130.84
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": 3,
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#10262C",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "city"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
