{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 3 — Choropleth by Primary Health Network (31 regions): change in % fully immunised, 2012–13 to 2016–17 (percentage points). Red = fell, blue = rose. Insets zoom into the capital cities.",
  "params": [
    {
      "name": "age",
      "value": "2 years",
      "bind": {"input": "select", "options": ["1 year", "2 years", "5 years"], "name": "Age: "}
    }
  ],
  "data": {"url": "data/phn_coverage.csv", "format": {"type": "csv", "parse": {"Percent": "number"}}},
  "transform": [
    {"filter": "datum.Age_group === age"},
    {"filter": {"field": "Reporting_Year", "oneOf": ["2012-13", "2016-17"]}},
    {"pivot": "Reporting_Year", "value": "Percent", "groupby": ["PHN_code", "PHN_name", "State"]},
    {"calculate": "datum['2016-17'] - datum['2012-13']", "as": "Change"},
    {"calculate": "(datum.Change > 0 ? '+' : '') + format(datum.Change, '.1f')", "as": "ChangeLabel"},
    {
      "lookup": "PHN_code",
      "from": {
        "data": {"url": "data/phn_boundaries.topojson", "format": {"type": "topojson", "feature": "phn"}},
        "key": "properties.PHN_code"
      },
      "as": "geo"
    }
  ],
  "spacing": 24,
  "resolve": {"scale": {"color": "shared"}},
  "hconcat": [
    {
      "width": 560,
      "height": 440,
      "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0]},
      "transform": [{"filter": "isValid(datum.geo)"}],
      "layer": [
        {
          "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.8},
          "encoding": {
            "shape": {"field": "geo", "type": "geojson"},
            "color": {
              "field": "Change",
              "type": "quantitative",
              "title": "Change (points)",
              "scale": {
                "domain": [-6, 0, 6],
                "range": ["#c23b3a", "#f0efec", "#2a78d6"],
                "interpolate": "lab",
                "clamp": true
              },
              "legend": {
                "orient": "bottom-left",
                "direction": "horizontal",
                "gradientLength": 180,
                "values": [-6, -3, 0, 3, 6]
              }
            },
            "tooltip": [
              {"field": "PHN_name", "title": "Region (PHN)"},
              {"field": "State"},
              {"field": "2012-13", "title": "2012–13 (%)", "type": "quantitative", "format": ".1f"},
              {"field": "2016-17", "title": "2016–17 (%)", "type": "quantitative", "format": ".1f"},
              {"field": "ChangeLabel", "title": "Change (points)"}
            ]
          }
        }
      ]
    },
    {
      "vconcat": [
        {
          "hconcat": [
            {
              "width": 150,
              "height": 150,
              "projection": {
                "type": "mercator",
                "center": [150.654, -34.077],
                "scale": 4711,
                "translate": [75, 75],
                "clipExtent": [[0, 0], [150, 150]]
              },
              "title": {"text": "Sydney", "fontSize": 12, "anchor": "start"},
              "transform": [{"filter": {"field": "PHN_code", "oneOf": ["PHN101", "PHN102", "PHN103", "PHN105"]}}],
              "layer": [
                {
                  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2},
                  "encoding": {
                    "shape": {"field": "geo", "type": "geojson"},
                    "color": {
                      "field": "Change",
                      "type": "quantitative",
                      "title": "Change (points)",
                      "scale": {
                        "domain": [-6, 0, 6],
                        "range": ["#c23b3a", "#f0efec", "#2a78d6"],
                        "interpolate": "lab",
                        "clamp": true
                      },
                      "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 180, "values": [-6, -3, 0, 3, 6]}
                    },
                    "tooltip": [
                      {"field": "PHN_name", "title": "Region (PHN)"},
                      {"field": "State"},
                      {"field": "2012-13", "title": "2012–13 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "2016-17", "title": "2016–17 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "ChangeLabel", "title": "Change (points)"}
                    ]
                  }
                },
                {
                  "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
                  "encoding": {
                    "longitude": {"field": "cx", "type": "quantitative"},
                    "latitude": {"field": "cy", "type": "quantitative"},
                    "text": {"field": "ChangeLabel"},
                    "color": {"condition": {"test": "abs(datum.Change) >= 3", "value": "#ffffff"}, "value": "#0b0b0b"}
                  },
                  "transform": [
                    {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "cx"},
                    {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "cy"}
                  ]
                }
              ],
              "view": {"stroke": "#e4e2dc", "strokeWidth": 1}
            },
            {
              "width": 150,
              "height": 150,
              "projection": {
                "type": "mercator",
                "center": [145.113, -37.84],
                "scale": 4727,
                "translate": [75, 75],
                "clipExtent": [[0, 0], [150, 150]]
              },
              "title": {"text": "Melbourne", "fontSize": 12, "anchor": "start"},
              "transform": [{"filter": {"field": "PHN_code", "oneOf": ["PHN201", "PHN202", "PHN203"]}}],
              "layer": [
                {
                  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2},
                  "encoding": {
                    "shape": {"field": "geo", "type": "geojson"},
                    "color": {
                      "field": "Change",
                      "type": "quantitative",
                      "title": "Change (points)",
                      "scale": {
                        "domain": [-6, 0, 6],
                        "range": ["#c23b3a", "#f0efec", "#2a78d6"],
                        "interpolate": "lab",
                        "clamp": true
                      },
                      "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 180, "values": [-6, -3, 0, 3, 6]}
                    },
                    "tooltip": [
                      {"field": "PHN_name", "title": "Region (PHN)"},
                      {"field": "State"},
                      {"field": "2012-13", "title": "2012–13 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "2016-17", "title": "2016–17 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "ChangeLabel", "title": "Change (points)"}
                    ]
                  }
                },
                {
                  "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
                  "encoding": {
                    "longitude": {"field": "cx", "type": "quantitative"},
                    "latitude": {"field": "cy", "type": "quantitative"},
                    "text": {"field": "ChangeLabel"},
                    "color": {"condition": {"test": "abs(datum.Change) >= 3", "value": "#ffffff"}, "value": "#0b0b0b"}
                  },
                  "transform": [
                    {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "cx"},
                    {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "cy"}
                  ]
                }
              ],
              "view": {"stroke": "#e4e2dc", "strokeWidth": 1}
            }
          ],
          "spacing": 14
        },
        {
          "hconcat": [
            {
              "width": 150,
              "height": 150,
              "projection": {
                "type": "mercator",
                "center": [152.924, -27.414],
                "scale": 3695,
                "translate": [75, 75],
                "clipExtent": [[0, 0], [150, 150]]
              },
              "title": {"text": "Brisbane & Gold Coast", "fontSize": 12, "anchor": "start"},
              "transform": [{"filter": {"field": "PHN_code", "oneOf": ["PHN301", "PHN302", "PHN303"]}}],
              "layer": [
                {
                  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2},
                  "encoding": {
                    "shape": {"field": "geo", "type": "geojson"},
                    "color": {
                      "field": "Change",
                      "type": "quantitative",
                      "title": "Change (points)",
                      "scale": {
                        "domain": [-6, 0, 6],
                        "range": ["#c23b3a", "#f0efec", "#2a78d6"],
                        "interpolate": "lab",
                        "clamp": true
                      },
                      "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 180, "values": [-6, -3, 0, 3, 6]}
                    },
                    "tooltip": [
                      {"field": "PHN_name", "title": "Region (PHN)"},
                      {"field": "State"},
                      {"field": "2012-13", "title": "2012–13 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "2016-17", "title": "2016–17 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "ChangeLabel", "title": "Change (points)"}
                    ]
                  }
                },
                {
                  "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
                  "encoding": {
                    "longitude": {"field": "cx", "type": "quantitative"},
                    "latitude": {"field": "cy", "type": "quantitative"},
                    "text": {"field": "ChangeLabel"},
                    "color": {"condition": {"test": "abs(datum.Change) >= 3", "value": "#ffffff"}, "value": "#0b0b0b"}
                  },
                  "transform": [
                    {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "cx"},
                    {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "cy"}
                  ]
                }
              ],
              "view": {"stroke": "#e4e2dc", "strokeWidth": 1}
            },
            {
              "width": 150,
              "height": 150,
              "projection": {
                "type": "mercator",
                "center": [115.9, -32.15],
                "scale": 4300,
                "translate": [75, 75],
                "clipExtent": [[0, 0], [150, 150]]
              },
              "title": {"text": "Perth", "fontSize": 12, "anchor": "start"},
              "transform": [{"filter": {"field": "PHN_code", "oneOf": ["PHN501", "PHN502"]}}],
              "layer": [
                {
                  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2},
                  "encoding": {
                    "shape": {"field": "geo", "type": "geojson"},
                    "color": {
                      "field": "Change",
                      "type": "quantitative",
                      "title": "Change (points)",
                      "scale": {
                        "domain": [-6, 0, 6],
                        "range": ["#c23b3a", "#f0efec", "#2a78d6"],
                        "interpolate": "lab",
                        "clamp": true
                      },
                      "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 180, "values": [-6, -3, 0, 3, 6]}
                    },
                    "tooltip": [
                      {"field": "PHN_name", "title": "Region (PHN)"},
                      {"field": "State"},
                      {"field": "2012-13", "title": "2012–13 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "2016-17", "title": "2016–17 (%)", "type": "quantitative", "format": ".1f"},
                      {"field": "ChangeLabel", "title": "Change (points)"}
                    ]
                  }
                },
                {
                  "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
                  "encoding": {
                    "longitude": {"field": "cx", "type": "quantitative"},
                    "latitude": {"field": "cy", "type": "quantitative"},
                    "text": {"field": "ChangeLabel"},
                    "color": {"condition": {"test": "abs(datum.Change) >= 3", "value": "#ffffff"}, "value": "#0b0b0b"}
                  },
                  "transform": [
                    {"calculate": "geoCentroid(null, datum.geo)[0]", "as": "cx"},
                    {"calculate": "geoCentroid(null, datum.geo)[1]", "as": "cy"}
                  ]
                }
              ],
              "view": {"stroke": "#e4e2dc", "strokeWidth": 1}
            }
          ],
          "spacing": 14
        }
      ],
      "spacing": 14
    }
  ]
}