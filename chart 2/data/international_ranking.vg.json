{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 820,
  "height": 520,

  "padding": {
    "left": 10,
    "right": 130,
    "top": 10,
    "bottom": 10
  },

  "title": {
    "text": "Australia Climbed the Rankings — Then Slipped Back",
    "subtitle": [
      "Countries are ranked by estimated DTP3 vaccination coverage.",
      "A lower rank number means a higher global position."
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "fontWeight": "bold",
    "color": "#333333",
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "subtitleColor": "#53636B",
    "subtitlePadding": 8,
    "offset": 18
  },

  "data": {
    "url": "dtp3_australia_peer_band_fixed.csv"
  },

  "layer": [

    {
      "transform": [
        {
          "filter": "datum.Country != 'Australia'"
        }
      ],

      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 1.4,
        "opacity": 0.55
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative",

          "scale": {
            "domain": [2010, 2025]
          },

          "axis": {
            "title": "Year",
            "format": "d",
            "values": [
              2010,
              2013,
              2015,
              2017,
              2019,
              2021,
              2023,
              2025
            ],
            "labelAngle": 0,
            "grid": false
          }
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          },

          "axis": {
            "title": "Global DTP3 rank",
            "values": [
              5,
              10,
              15,
              20,
              25,
              30,
              35
            ],
            "labelExpr": "'#' + datum.value",
            "grid": true
          }
        },

        "color": {
          "field": "Country",
          "type": "nominal",

          "scale": {
            "scheme": "tableau20"
          },

          "legend": null
        },

        "detail": {
          "field": "Country"
        },

        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Rank",
            "type": "quantitative",
            "title": "Global rank",
            "format": ".0f"
          },
          {
            "field": "Coverage",
            "type": "quantitative",
            "title": "DTP3 coverage",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country != 'Australia'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 38,
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 0.8
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "color": {
          "field": "Country",
          "type": "nominal",

          "scale": {
            "scheme": "tableau20"
          },

          "legend": null
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia'"
        }
      ],

      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 5,
        "color": "#0057FF"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "tooltip": [
          {
            "field": "Country",
            "title": "Country"
          },
          {
            "field": "Year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Rank",
            "title": "Global rank",
            "format": ".0f"
          },
          {
            "field": "Coverage",
            "title": "DTP3 coverage",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 95,
        "color": "#0057FF",
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Year == 2025 && datum.Country != 'Australia'"
        },

        {
          "calculate": "replace(replace(replace(datum.Country, 'United States of America', 'United States'), 'United Kingdom of Great Britain and Northern Ireland', 'United Kingdom'), 'Netherlands (Kingdom of the)', 'Netherlands')",
          "as": "CountryLabel"
        },

        {
          "calculate": "datum.Country == 'Italy' ? 17.5 : datum.Country == 'United States of America' ? 18.8 : datum.Country == 'Greece' ? 20.1 : datum.Country == 'Poland' ? 21.4 : datum.Country == 'Spain' ? 22.7 : datum.Country == 'United Kingdom of Great Britain and Northern Ireland' ? 23.8 : datum.Country == 'Canada' ? 25.2 : datum.Country == 'Finland' ? 26.3 : datum.Country == 'Japan' ? 27.4 : datum.Country == 'Slovenia' ? 28.5 : datum.Country == 'Iceland' ? 29.6 : datum.Country == 'Ireland' ? 30.7 : datum.Country == 'Netherlands (Kingdom of the)' ? 31.8 : datum.Country == 'Lithuania' ? 32.9 : datum.Country == 'Germany' ? 34.0 : datum.Rank",
          "as": "LabelY"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 10,
        "fontWeight": "bold"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "LabelY",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "text": {
          "field": "CountryLabel"
        },

        "color": {
          "field": "Country",
          "type": "nominal",

          "scale": {
            "scheme": "tableau20"
          },

          "legend": null
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Year == 2025 && datum.Country == 'Australia'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#0057FF"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "text": {
          "value": "Australia"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia' && datum.Year == 2021"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#0057FF",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia' && datum.Year == 2021"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 10,
        "dy": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#0057FF"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "text": {
          "value": "Best rank: #18"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia' && datum.Year == 2025"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#0057FF",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.Country == 'Australia' && datum.Year == 2025"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -15,
        "dy": -16,
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#0057FF"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative"
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [3, 37],
            "reverse": true
          }
        },

        "text": {
          "value": "Australia ranked #24 in 2025"
        }
      }
    }

  ],

  "config": {

    "view": {
      "stroke": null
    },

    "axis": {
      "domain": false,
      "gridColor": "#E7E7E7",
      "gridOpacity": 0.75,
      "tickColor": "#CCCCCC",
      "labelColor": "#53636B",
      "titleColor": "#53636B",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "bold"
    },

    "title": {
      "font": "Arial"
    }
  }
}